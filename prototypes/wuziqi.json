{
  "id": "wuziqi",
  "display_name": "五子棋",
  "description": "五子棋是一款经典的双人对弈游戏，两人各执黑白棋，黑棋先手，率先将五子连成一条线者获胜。",
  "size": "1x1",
  "layout": {
    "width": 15,
    "height": 15,
    "components": [
      {
        "type": "grid",
        "id": "board",
        "width": 15,
        "height": 15,
        "line_position": "intersect",
        "line_width": 1
      }
    ]
  },
  "teaming": {
    "duplicatable": true,
    "default_team_config": {
      "min_players": 1,
      "max_players": 1
    },
    "explicit_teams": [
      {
        "id": "black",
        "display_name": "黑方",
        "turn_actions": {
          "type": "place_piece",
          "id": "black",
          "on": "board"
        }
      },
      {
        "id": "white",
        "display_name": "白方",
        "turn_actions": {
          "type": "place_piece",
          "id": "white",
          "on": "board"
        }
      }
    ]
  },
  "status_displays": [
    {
      "type": "turn_text",
      "ours": "轮到您落子",
      "others": "轮到对方落子"
    }
  ],
  "event_handlers": [
    {
      "type": "game_start",
      "actions": {
        "type": "set_turn",
        "value": "black"
      }
    },
    {
      "type": "piece_place",
      "actions": [
        {
          "type": "merge_or_create_piece_group",
          "id": "horizontal",
          "directions": "horizontal"
        },
        {
          "type": "merge_or_create_piece_group",
          "id": "vertical",
          "directions": "vertical"
        },
        {
          "type": "merge_or_create_piece_group",
          "id": "main_diagonal",
          "directions": "main_diagonal"
        },
        {
          "type": "merge_or_create_piece_group",
          "id": "secondary_diagonal",
          "directions": "secondary_diagonal"
        },
        {
          "type": "win_check",
          "conditions": {
            "any_of": [
              {
                "type": "greater_equal",
                "piece_group": "horizontal",
                "value": 5
              },
              {
                "type": "greater_equal",
                "piece_group": "vertical",
                "value": 5
              },
              {
                "type": "greater_equal",
                "piece_group": "main_diagonal",
                "value": 5
              },
              {
                "type": "greater_equal",
                "piece_group": "secondary_diagonal",
                "value": 5
              }
            ]
          }
        },
        {
          "type": "set_turn",
          "value": "#next"
        }
      ]
    }
  ]
}